generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  // seed: ts-node prisma/seed.ts  (configured in package.json)
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MODEL
  BRAND
  ADMIN
  PHOTOGRAPHER
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  role                Role
  approved            Boolean               @default(false)
  emailVerified       Boolean               @default(false)
  verified            Boolean               @default(false)
  verificationToken   String?               @unique
  resetToken          String?               @unique
  resetTokenExpiry    DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  modelProfile        ModelProfile?
  brandProfile        BrandProfile?
  photographerProfile PhotographerProfile?
  sentMessages        Message[]             @relation("SentMessages")
  threads             ThreadMember[]
  swipesMade          Swipe[]               @relation("SwipesMade")
  matchesAsUser1      Match[]               @relation("MatchesAsUser1")
  matchesAsUser2      Match[]               @relation("MatchesAsUser2")
  verificationRequest VerificationRequest?
  communityFlagged    Boolean               @default(false)
  reviewsGiven        Review[]              @relation("ReviewsGiven")
  reviewsReceived     Review[]              @relation("ReviewsReceived")
  structuredReviewsGiven     StructuredReview[]    @relation("StructuredReviewsGiven")
  structuredReviewsReceived  StructuredReview[]    @relation("StructuredReviewsReceived")
  workingTogetherPosts       WorkingTogetherPost[] @relation("PostsAuthored")
  savedProfiles       SavedProfile[]        @relation("ProfilesSaved")
  tutorialsAuthored   Tutorial[]
  spotlight           Spotlight?
  reportsMade         Report[]              @relation("ReportsMade")
  reportsReceived     Report[]              @relation("ReportsReceived")
  blocksMade          Block[]               @relation("BlocksMade")
  blocksReceived      Block[]               @relation("BlocksReceived")
}

model ModelProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  bio             String?
  location        String?
  instagramUrl    String?
  heightCm        Int?
  bustCm          Int?
  waistCm         Int?
  hipsCm          Int?
  shoeSize        Float?
  hairColor       String?
  eyeColor        String?
  skinTone        String?
  rates           Json?
  availability    Json?
  profileImage    String?
  portfolioImages String[]
  coverImage      String?
  tags            String[]
  applications    Application[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BrandProfile {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName    String
  industry     String?
  website      String?
  logoUrl      String?
  bio          String?
  location     String?
  instagramUrl String?
  profileImage String?
  campaigns    Campaign[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model PhotographerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  bio             String?
  location        String?
  instagramUrl    String?
  profileImage    String?
  specialties     String[]  @default([])
  portfolioImages String[]  @default([])
  coverImage      String?
  rates           Json?
  availability    Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Campaign {
  id           String         @id @default(cuid())
  brandId      String
  brand        BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title        String
  description  String
  budget       String?
  location     String?
  startDate    DateTime?
  endDate      DateTime?
  tags         String[]
  status       CampaignStatus @default(DRAFT)
  flagged      Boolean        @default(false)
  applications Application[]
  reviews      Review[]
  structuredReviews  StructuredReview[]
  workingTogetherPosts WorkingTogetherPost[] @relation("CampaignPosts")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Application {
  id         String            @id @default(cuid())
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  modelId    String
  model      ModelProfile      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  coverNote  String?
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([campaignId, modelId])
}

model Thread {
  id        String         @id @default(cuid())
  members   ThreadMember[]
  messages  Message[]
  createdAt DateTime       @default(now())
}

model ThreadMember {
  threadId   String
  userId     String
  lastReadAt DateTime?
  thread     Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model VerificationRequest {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  idImageUrl  String
  selfieUrl   String?
  status      VerificationStatus @default(PENDING)
  adminNote   String?
  submittedAt DateTime           @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
}

model Swipe {
  id         String   @id @default(cuid())
  swiperId   String
  targetId   String
  targetType String
  direction  String
  createdAt  DateTime @default(now())
  swiper     User     @relation("SwipesMade", fields: [swiperId], references: [id])

  @@unique([swiperId, targetId, targetType])
}

model Match {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  user1     User     @relation("MatchesAsUser1", fields: [user1Id], references: [id])
  user2     User     @relation("MatchesAsUser2", fields: [user2Id], references: [id])

  @@unique([user1Id, user2Id])
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  revieweeId String
  campaignId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  @@unique([reviewerId, revieweeId, campaignId])
}

model SavedProfile {
  id        String   @id @default(cuid())
  savedById String
  savedId   String
  boardName String   @default("Saved")
  createdAt DateTime @default(now())
  savedBy   User     @relation("ProfilesSaved", fields: [savedById], references: [id])

  @@unique([savedById, savedId, boardName])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  reportedId String
  reason     String
  details    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  reporter   User     @relation("ReportsMade", fields: [reporterId], references: [id])
  reported   User     @relation("ReportsReceived", fields: [reportedId], references: [id])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model StructuredReview {
  id               String   @id @default(cuid())
  reviewerId       String
  revieweeId       String
  campaignId       String
  dimensions       Json
  overallRating    Float
  comment          String?
  reviewerResponse String?
  responseDeadline DateTime
  isPublic         Boolean  @default(false)
  flagCount        Int      @default(0)
  adminFlagged     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  reviewer         User     @relation("StructuredReviewsGiven", fields: [reviewerId], references: [id])
  reviewee         User     @relation("StructuredReviewsReceived", fields: [revieweeId], references: [id])
  campaign         Campaign @relation(fields: [campaignId], references: [id])

  @@unique([reviewerId, revieweeId, campaignId])
}

model WorkingTogetherPost {
  id               String   @id @default(cuid())
  authorId         String
  campaignId       String
  content          String
  isPublic         Boolean  @default(false)
  responseDeadline DateTime
  subjectResponse  String?
  adminFlagged     Boolean  @default(false)
  createdAt        DateTime @default(now())
  author           User     @relation("PostsAuthored", fields: [authorId], references: [id])
  campaign         Campaign @relation("CampaignPosts", fields: [campaignId], references: [id])
}

enum TutorialCategory {
  MODELING
  BEAUTY
  PHOTOGRAPHY
  BUSINESS
  INDUSTRY_GUIDES
}

enum TutorialDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Tutorial {
  id           String             @id @default(cuid())
  title        String
  description  String
  category     TutorialCategory
  difficulty   TutorialDifficulty
  duration     Int
  thumbnailUrl String?
  videoUrl     String?
  authorId     String?
  published    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  author       User?              @relation(fields: [authorId], references: [id])
}

model Spotlight {
  id        String   @id @default(cuid())
  userId    String   @unique
  type      String
  weekOf    DateTime
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
